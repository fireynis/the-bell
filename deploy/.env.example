# Environment for deploy/docker-compose.yml — the self-contained stack for a new
# town. Copy to deploy/.env and fill in. Full walkthrough: deploy/README.md

# ─── Required ────────────────────────────────────────────────────────

# Password for the PostgreSQL database user (belluser)
POSTGRES_PASSWORD=changeme

# Kratos signs session cookies with these. They have no defaults on purpose:
# a secret committed to a repository is a secret everyone has, and a missing one
# is worse than it looks — Kratos does not fail, it silently generates a random
# cookie secret on each boot, so every restart logs every resident out.
#
# Generate:
#   KRATOS_SECRETS_COOKIE   openssl rand -hex 32
#   KRATOS_SECRETS_CIPHER   openssl rand -hex 16
#
# KRATOS_SECRETS_CIPHER must be EXACTLY 32 characters. Kratos enforces a minimum
# AND a maximum of 32 and refuses to boot otherwise, so `openssl rand -hex 32`
# (64 characters) does NOT work here — use `-hex 16`.
#
# Rotating the cookie secret invalidates every existing session.
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=

# ─── Public address ──────────────────────────────────────────────────

# The URL residents type into a browser. Every Kratos URL — login and
# registration pages, redirects, CORS origins, and the session cookie domain —
# is derived from this one value at container start, and The Bell itself uses
# it to build invitation links.
#
# It must match the address actually used. A cookie scoped to the wrong host is
# dropped by the browser, and the symptom is a login that appears to succeed and
# then leaves the resident logged out, with nothing in the logs.
#
# No trailing slash. Include a non-standard port if you use one.
PUBLIC_URL=http://localhost:8080

# Host port for the app. If you change this, PUBLIC_URL must agree.
BELL_PORT=8080

# ─── HTTP vs HTTPS ───────────────────────────────────────────────────
# Defaults suit a plain-HTTP trial run on localhost.
#
# For a real town on a public domain (PUBLIC_URL=https://...), set BOTH of these
# to empty so cookies are issued with the Secure attribute:
#
#   KRATOS_EXTRA_ARGS=
#   BELL_ENV=
#
# and put the stack behind a TLS reverse proxy (see deploy/README.md).
#
# KRATOS_EXTRA_ARGS=--dev  runs Kratos in development mode: it does not require
# HTTPS and issues non-Secure cookies. Never use it on a public address.
KRATOS_EXTRA_ARGS=--dev

# BELL_ENV=dev strips the Secure attribute from session cookies as they pass
# back through The Bell's /.ory proxy, which is what lets login work over
# plain HTTP. Leave empty for anything reachable over a network.
BELL_ENV=dev

# ─── Optional ────────────────────────────────────────────────────────

# Town name displayed in the UI header, and the From name on outgoing mail
TOWN_NAME=My Town

# Outbound mail for password recovery, email verification, AND invitations.
#
# The bell binary reads the same two variables Kratos's courier does — the
# compose file passes them through as SMTP_CONNECTION_URI and
# SMTP_FROM_ADDRESS — so setting a relay once serves both.
#
# Recovery and verification are enabled in the UI, so without a working relay a
# resident who forgets their password cannot get back in: the message is
# generated and then fails to send.
#
# Invitations degrade instead of failing: the invitation is still created, the
# API reports email_sent:false with a reason, and the member passes the link on
# themselves. A town can run invite-only with no relay at all.
#
# Must begin with smtp:// or smtps://. An empty value is rejected outright by
# Kratos, so the compose default is a placeholder pointing at nothing.
#
#   COURIER_SMTP_CONNECTION_URI=smtps://user:password@smtp.example.com:465/
#
# URL-encode special characters in the password (@ becomes %40). For a relay
# without STARTTLS, append ?disable_starttls=true.
# COURIER_SMTP_CONNECTION_URI=
# COURIER_SMTP_FROM_ADDRESS=noreply@example.com

# TESTING ONLY: the mailhog service (behind the `mailtest` compose profile)
# catches all outgoing mail and shows it at http://<host>:8025 — including
# live recovery links AND live invitation links for every account, so never on
# a town with real residents. It is the easiest way to read an invitation
# end-to-end before pointing at a real relay. To use it, set both of:
# COMPOSE_PROFILES=mailtest
# COURIER_SMTP_CONNECTION_URI=smtp://mailhog:1025/?disable_starttls=true
# MAILHOG_UI_PORT=8025

# How often the check-roles sidecar runs `bell check-roles`. Default 86400 =
# daily. That command does moderator promotion and demotion AND recomputes
# trust scores, so without Redis this interval also sets how fast moderation
# penalties decay and tenure accrues. Leave it daily.
# CHECK_ROLES_INTERVAL_SECONDS=86400

# How often the in-process trust worker recalculates every active user, so that
# moderation penalties decay and tenure accrues for residents nothing is
# happening to. Read by the bell binary, unlike the sidecar interval above.
#
# A Go DURATION, not seconds: 24h, 12h, 90m. A bare number is refused at
# startup, as are zero and negative values.
#
# Daily is right. The shortest penalty decay window is 90 days and tenure
# resolves to a day, so a shorter interval mostly buys work; a longer one leaves
# penalties in force past the point the moderator who applied them intended.
#
# This stack ships Redis, so the worker is running. On a deployment without it,
# `bell check-roles` is the only thing that recalculates trust and this has no
# effect.
# TRUST_SWEEP_INTERVAL=24h

# ─── Registration and verification ───────────────────────────────────
#
# Whether the town admits people by invitation or by open sign-up is NOT set
# here — it is town configuration, changed by the council from the admin screen
# (or via PUT /api/v1/admin/config), because it is a decision the town makes
# rather than one the operator makes at deploy time. New towns start
# invite-only. See "Registration modes" in docs/admin-guide.md.
#
# Both variables below are passed through to the bell service by
# deploy/docker-compose.yml and are optional, defaulting to the safe value.

# Which peers may speak for somebody else, as comma-separated IP addresses and
# CIDR blocks.
#
# Registration is unauthenticated, so its rate limit (10 requests per hour) is
# keyed by client IP. Unset, the client IP is whatever address the TCP
# connection came from — which, if you have put this stack behind a TLS reverse
# proxy as deploy/README.md recommends, is the proxy. The whole town then shares
# one registration budget.
#
# Set it to the network your proxy connects from. Leave it empty when residents
# reach the published port directly, which is the case for the default
# plain-HTTP trial run.
#
# Empty is the safe default: X-Forwarded-For is an ordinary request header, so
# trusting it from an address that is not actually your proxy lets any caller
# claim a fresh rate-limit bucket per request. A value that does not parse stops
# the container at startup.
# TRUSTED_PROXIES=172.18.0.0/16

# Require a verified email address before a resident may participate.
# Default false.
#
# When true, a resident whose Kratos identity has no verified address can sign
# in and load their own status page, and gets
# 403 {"error":"email not verified"} from everything else.
#
# DO NOT ENABLE THIS UNTIL COURIER_SMTP_CONNECTION_URI WORKS. The verification
# mail is the only way for a resident to clear the check, so with no working
# relay this locks out the whole town — including the council members who would
# have to turn it back off. Configure the courier above, confirm a real
# verification mail arrives, and only then set this.
#
# It applies to residents who registered before it was enabled as well:
# verification is read from Kratos on every request, not recorded at sign-up.
# REQUIRE_VERIFIED_EMAIL=true

# ─── Kratos URLs (override only for an external Kratos instance) ─────
# These point at the bundled Kratos container on the internal Docker network.
# KRATOS_PUBLIC_URL=http://kratos:4433
# KRATOS_ADMIN_URL=http://kratos:4434
