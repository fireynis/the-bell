# Environment for the ROOT docker-compose.yml — the maintainer's own deployment
# of bell.themacarthurs.ca (Traefik labels, an external `proxy` network, and
# host paths under /storage/the-bell).
#
# Setting up a new town? Use deploy/ instead — see deploy/README.md. That stack
# is self-contained and takes the public URL from one variable.

# === Required ========================================================

POSTGRES_PASSWORD=changeme

# Kratos signs session cookies with these. They are NOT optional and have no
# default: Kratos does not fail when they are missing, it quietly generates a
# random cookie secret on every boot, which logs every user out on each restart.
# Compose therefore refuses to start until both are set.
#
# Generate:
#   KRATOS_SECRETS_COOKIE   openssl rand -hex 32
#   KRATOS_SECRETS_CIPHER   openssl rand -hex 16
#
# The cipher secret must be EXACTLY 32 characters — Kratos enforces both a
# minimum and a maximum of 32 and refuses to boot otherwise. `openssl rand -hex
# 16` produces 32 characters; `-hex 32` produces 64 and is rejected.
#
# Rotating the cookie secret invalidates every existing session.
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=

# === Optional ========================================================

TOWN_NAME=My Town

# Outbound mail for password recovery and email verification. Both flows are
# enabled, so without a working relay a resident who forgets their password has
# no way back into their account — the mail is generated and fails at send time.
# Must start with smtp:// or smtps://; an empty value is rejected by Kratos.
# The default is a placeholder that points nowhere.
#
#   COURIER_SMTP_CONNECTION_URI=smtps://user:password@smtp.example.com:465/
#
# Passwords must be URL-encoded (@ becomes %40). For a relay that does not do
# STARTTLS, append ?disable_starttls=true.
# COURIER_SMTP_CONNECTION_URI=
# COURIER_SMTP_FROM_ADDRESS=noreply@bell.themacarthurs.ca

# TESTING ONLY: the mailhog service (behind the `mailtest` compose profile)
# catches all outgoing mail and shows it at http://<host>:8025 — including
# live recovery links for every account, so never on a town with real
# residents. To use it, set both of:
# COMPOSE_PROFILES=mailtest
# COURIER_SMTP_CONNECTION_URI=smtp://mailhog:1025/?disable_starttls=true
# MAILHOG_UI_PORT=8025

# How often the bell-check-roles sidecar runs `bell check-roles`. Default
# 86400 = daily. That command does moderator promotion and demotion AND
# recomputes trust scores, so on a deployment without Redis this interval also
# sets how fast moderation penalties decay and tenure accrues. Leave it daily.
# CHECK_ROLES_INTERVAL_SECONDS=86400

# How often the in-process trust worker recalculates every active user, so that
# moderation penalties decay and tenure accrues for people nothing is happening
# to. Read by the bell binary itself, unlike CHECK_ROLES_INTERVAL_SECONDS above.
#
# A Go DURATION, not a number of seconds: 24h, 12h, 90m. A bare number is
# refused at startup, as are zero and negative values.
#
# Daily is right. The shortest penalty decay window is 90 days and tenure
# resolves to a day, so a shorter interval mostly buys work; a longer one leaves
# penalties in force past the point the moderator who applied them intended.
#
# Has no effect without REDIS_URL — there is no worker to sweep, and
# `bell check-roles` becomes the only thing that recalculates trust.
# TRUST_SWEEP_INTERVAL=24h

# Both variables below are passed through to the bell service by
# docker-compose.yml and are optional, defaulting to the safe value.

# Which peers may speak for somebody else, as comma-separated IP addresses and
# CIDR blocks. Read by the bell binary.
#
# It is what makes the registration rate limit per-resident rather than
# per-deployment. Registration is unauthenticated, so its limit is keyed by
# client IP — and unset, the "client IP" behind a reverse proxy is the proxy.
# This deployment runs behind Traefik, so leaving it empty puts the entire town
# in one bucket of 10 registration requests an hour.
#
# Set it to the network Traefik reaches the app on. `docker network inspect
# proxy` reports the subnet.
#
# Empty is the safe default, not the right one here: X-Forwarded-For is an
# ordinary request header, so trusting it from an address that is NOT your proxy
# lets any caller mint a fresh rate-limit bucket per request. A value that does
# not parse stops the process at startup.
# TRUSTED_PROXIES=172.18.0.0/16

# Require a verified email address before a resident may participate. Read by
# the bell binary. Default false.
#
# When true, a resident whose Kratos identity has no verified address can sign
# in and load /api/v1/me — so the UI can tell them why — and gets
# 403 {"error":"email not verified"} from everything else.
#
# DO NOT ENABLE THIS UNTIL COURIER_SMTP_CONNECTION_URI WORKS. The verification
# mail is the only way to clear the check, so with no working relay this locks
# out every resident, including the council members who would have to turn it
# back off. Configure the courier, send yourself a real verification mail, and
# only then set this.
#
# It applies to residents who registered earlier too — verification is read from
# Kratos on every request, not at sign-up — so expect questions on the day you
# turn it on.
# REQUIRE_VERIFIED_EMAIL=true

# Leave BELL_ENV unset in production. Only "dev"/"development" enable dev mode;
# anything else (including unset or a typo) means production. Dev mode strips
# the Secure attribute from Kratos session cookies so plain-HTTP localhost
# works — never enable it on a networked deployment.
# BELL_ENV=dev

# === Reference values (hardcoded in docker-compose.yml, listed here for documentation) ===
# The Postgres role is belluser (POSTGRES_USER in both compose files). Service
# hostnames differ between the two composes: docker-compose.yml uses
# bell-postgres/redis-bell, deploy/docker-compose.yml uses postgres/redis.
# The values below mirror the root docker-compose.yml.
# DATABASE_URL=postgres://belluser:${POSTGRES_PASSWORD}@bell-postgres:5432/bell?sslmode=disable
# REDIS_URL=redis://redis-bell:6379
# KRATOS_PUBLIC_URL=http://kratos:4433
# KRATOS_ADMIN_URL=http://kratos:4434
# Kratos reads this as its own DSN env var, not KRATOS_DSN:
# DSN=postgres://belluser:${POSTGRES_PASSWORD}@bell-postgres:5432/bell_kratos?sslmode=disable
# PORT=8080
# IMAGE_STORAGE_PATH=/storage/the-bell/images
